# ==================
#
#  CUSTOM
#
#  put below your custom ignore rules
#  for example , if you want to include a
#  module directly in repositoryyou can do:
#
#  !modules/yourmodule
#
# ==================

# Live-stack e2e private / local tooling (scratch tests stay uncommitted)
e2e/local/**
!e2e/local/README.md
e2e/go.work
e2e/go.work.sum

.cache
compile_commands.json

#
# Local server setup
#

# Runtime: binaries, client data, configs with credentials, logs
/server/
# Third-party libraries and tools (vcpkg, MySQL, OpenSSL, archives)
/dependencies/
/backups/
# Generated client patch packages
/clientPatcher/dist/
/clientPatcher/.stage/
/clientPatcher/.release/
/clientPatcher/launcher/bin/
/clientPatcher/launcher/obj/
/clientPatcher/vendor/
# Generated by localTools/customClasses and localTools/mpq-builder/extractClientDbc.js
/clientPatcher/.dbccache/
/clientPatcher/interface/DBFilesClient/
# MPQ builder packages and output
/localTools/mpq-builder/node_modules/
/localTools/mpq-builder/*.MPQ

# TACTTool download cache of localTools/interface/extractRetailUi.py
localTools/interface/cache/
