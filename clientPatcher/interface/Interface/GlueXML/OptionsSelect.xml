<!-- Autora: Noa -->
<!--
	Evolutions: the Options menu of the login and character screens, redrawn in the login screen's look (a dark card
	with a gold hairline over the dimmed screen, gold heading, full-width rows). The look is built by OptionsSelect.lua;
	every button keeps its original action.
-->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="OptionsSelect.lua"/>

	<!-- A row of the menu: no stock art, its title, line and light come from OptionsSelect.lua -->
	<Button name="EvolutionsOptionsRowTemplate" virtual="true">
		<Size x="352" y="46"/>
		<Scripts>
			<OnEnter>
				OptionsSelect_RowHover(self, true);
			</OnEnter>
			<OnLeave>
				OptionsSelect_RowHover(self, false);
			</OnLeave>
			<OnMouseDown>
				self.pressed = true;
			</OnMouseDown>
			<OnMouseUp>
				self.pressed = nil;
			</OnMouseUp>
		</Scripts>
	</Button>

	<Frame name="OptionsSelectFrame" toplevel="true" setAllPoints="true" hidden="true" enableMouse="true" enableKeyboard="true" frameStrata="HIGH">
		<Frames>
			<Frame name="$parentBackground">
				<Size x="400" y="384"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parentHeaderText" inherits="GlueFontNormal" text="OPTIONS">
							<Anchors>
								<Anchor point="TOP">
									<Offset x="0" y="-22"/>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame name="$parentContainer">
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset x="24" y="-76"/>
							</Anchor>
							<Anchor point="BOTTOMRIGHT">
								<Offset x="-24" y="84"/>
							</Anchor>
						</Anchors>
						<Frames>
							<Button name="$parentVideoOptionsButton" inherits="EvolutionsOptionsRowTemplate">
								<Anchors>
									<Anchor point="TOP"/>
								</Anchors>
								<Scripts>
									<OnClick>
										PlaySound("igMainMenuOption");
										VideoOptionsFrame.lastFrame = OptionsSelectFrame;
										VideoOptionsFrame:Show();
									</OnClick>
								</Scripts>
							</Button>
							<Button name="$parentAudioOptionsButton" inherits="EvolutionsOptionsRowTemplate">
								<Anchors>
									<Anchor point="TOP" relativeTo="$parentVideoOptionsButton" relativePoint="BOTTOM">
										<Offset x="0" y="-8"/>
									</Anchor>
								</Anchors>
								<Scripts>
									<OnClick>
										PlaySound("igMainMenuOption");
										AudioOptionsFrame.lastFrame = OptionsSelectFrame;
										AudioOptionsFrame:Show();
									</OnClick>
								</Scripts>
							</Button>
							<Button name="$parentTrailersButton" inherits="EvolutionsOptionsRowTemplate">
								<Anchors>
									<Anchor point="TOP" relativeTo="$parentAudioOptionsButton" relativePoint="BOTTOM">
										<Offset x="0" y="-8"/>
									</Anchor>
								</Anchors>
								<Scripts>
									<OnClick>
										PlaySound("igMainMenuOption");
										MovieList_Show();
									</OnClick>
								</Scripts>
							</Button>
							<!-- The one action that cannot be taken back: set apart below a hairline, in a muted red -->
							<Button name="$parentRealmResetOptionsButton" inherits="EvolutionsOptionsRowTemplate">
								<Anchors>
									<Anchor point="TOP" relativeTo="$parentTrailersButton" relativePoint="BOTTOM">
										<Offset x="0" y="-25"/>
									</Anchor>
								</Anchors>
								<Scripts>
									<OnClick>
										PlaySound("igMainMenuOption");
										AccountLogin_RealmReset();
									</OnClick>
								</Scripts>
							</Button>
						</Frames>
					</Frame>
					<!-- The user options reset (a toggle: GlueDialog.lua switches it to "cancel the reset" and back),
					     a quiet link at the bottom left -->
					<Button name="OptionsSelectResetSettingsButton" text="RESET_SETTINGS">
						<Size x="220" y="24"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT">
								<Offset x="22" y="24"/>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								OptionsSelectResetSettingsButton_OnClick_Reset(self);
							</OnClick>
							<OnEnter>
								OptionsSelect_RowHover(self, true);
							</OnEnter>
							<OnLeave>
								OptionsSelect_RowHover(self, false);
							</OnLeave>
						</Scripts>
						<ButtonText name="$parentText" justifyH="LEFT">
							<Anchors>
								<Anchor point="LEFT">
									<Offset x="2" y="0"/>
								</Anchor>
							</Anchors>
						</ButtonText>
						<NormalFont style="EvolutionsLoginLinkFont"/>
						<HighlightFont style="EvolutionsLoginLinkHighlightFont"/>
						<DisabledFont style="EvolutionsLoginLinkDisabledFont"/>
					</Button>
					<Button name="$parentOkayButton" inherits="GlueButtonSmallTemplateBlue" text="CLOSE">
						<Size x="116" y="32"/>
						<Anchors>
							<Anchor point="BOTTOMRIGHT">
								<Offset x="-24" y="20"/>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								OptionsSelectFrame_Hide();
							</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				OptionsSelectFrame_OnLoad(self);
			</OnLoad>
			<OnShow>
				OptionsSelectFrame_OnShow(self);
			</OnShow>
			<OnUpdate>
				OptionsSelectFrame_OnUpdate(self, elapsed);
			</OnUpdate>
			<OnKeyDown>
				if ( key == "ESCAPE" ) then
					OptionsSelectFrame_Hide();
				elseif ( key == "PRINTSCREEN" ) then
					Screenshot();
				end
			</OnKeyDown>
		</Scripts>
	</Frame>
</Ui>
