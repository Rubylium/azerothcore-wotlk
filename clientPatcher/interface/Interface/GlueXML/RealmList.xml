<!-- Evolutions: realm selection, drawn in RealmList.lua -->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="RealmList.lua"/>
	<Frame name="RealmList" toplevel="true" parent="GlueParent" setAllPoints="true" enableMouse="true" enableKeyboard="true" frameStrata="DIALOG" hidden="true">
		<Frames>
			<!-- Never shown: the stock French GlueLocalization.lua (LocalizeFrames) resizes the old list's sort buttons -->
			<Frame name="RealmCharactersSort" hidden="true">
				<Size>
					<AbsDimension x="100" y="19"/>
				</Size>
			</Frame>
			<Frame name="RealmLoadSort" hidden="true">
				<Size>
					<AbsDimension x="100" y="19"/>
				</Size>
			</Frame>
			<Button name="RealmListCancelButton" inherits="GlueButtonTemplate" text="CANCEL">
				<Size>
					<AbsDimension x="190" y="42"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="-8" y="44"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						RealmList_OnCancel();
					</OnClick>
				</Scripts>
			</Button>
			<Button name="RealmListOkButton" inherits="GlueButtonTemplate">
				<Size>
					<AbsDimension x="190" y="42"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="8" y="44"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						RealmList_OnOk();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				RealmList_OnLoad(self);
			</OnLoad>
			<OnEvent>
				RealmList_OnEvent(self, event);
			</OnEvent>
			<OnShow>
				RealmList_OnShow(self);
			</OnShow>
			<OnHide>
				RealmList_OnHide(self);
			</OnHide>
			<OnUpdate>
				RealmList_OnUpdate(self, elapsed);
			</OnUpdate>
			<OnSizeChanged>
				RealmList_Layout(self);
			</OnSizeChanged>
			<OnKeyDown>
				RealmList_OnKeyDown(key);
			</OnKeyDown>
		</Scripts>
	</Frame>
</Ui>
