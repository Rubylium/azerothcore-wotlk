<Window x:Class="Evolutions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Evolutions"
        Title="Evolutions"
        Width="1200" Height="720"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Base}"
        Icon="Assets/Evolutions.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Text}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- "La Forge" (.agents/plans/launcher-forge): a forge whose heat is the launcher's state. The pages are
             stamped tabs on the header band; the current one is molten. -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Pages" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="2" Padding="14,7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter TargetName="Back" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource GoldBrush}" />
                                <Setter Property="Foreground" Value="#FF1B1410" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar buttons, small iron squares -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="#FF22252B" BorderBrush="#FF454A54" BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="#FF22252B" BorderBrush="#FF454A54" BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#FFB0401A" />
                                <Setter TargetName="Back" Property="BorderBrush" Value="#FFFF8A2A" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary actions: a stamped iron plate, rimmed in molten metal under the mouse -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="2" BorderThickness="1" BorderBrush="#FF454A54"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF33363E" Offset="0" />
                                    <GradientStop Color="#FF24272D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource GoldLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Content" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GoldLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ingot is painted around it (IngotArea): the button itself is only its hit area and its words -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The game tools: a small iron square beside the ingot -->
        <Style x:Key="PlayMenuButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PlayMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="3" Padding="6" BorderThickness="1" BorderBrush="#FF454A54"
                                Background="#FA1B1D22" Margin="0,8,0,0">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Back" CornerRadius="2" Padding="12,9" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter ContentSource="Icon" Width="16" Margin="0,0,12,0"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FF8A2A" />
                                <Setter Property="Foreground" Value="{StaticResource GoldLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="2" Background="#FF454A54" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Stamp" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
        </Style>

        <!-- The home page's chronicle: one stamped line per article, its tag and date, then its title -->
        <DataTemplate x:Key="NewsCard">
            <Button Style="{StaticResource LinkButton}" Click="OnNewsCardClick" Tag="{Binding}" Margin="0,0,0,8">
                <Border x:Name="Card" CornerRadius="2" BorderThickness="1" BorderBrush="#FF353942" Padding="14,9"
                        Background="#D91B1D22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tag}" Style="{StaticResource Stamp}" FontSize="11" />
                            <TextBlock Text="  ·  " Style="{StaticResource Stamp}" FontSize="11"
                                       Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"
                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Gold}" />
                    <Setter TargetName="Card" Property="Background" Value="#E62A231E" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An article on the news page, on its iron plate -->
        <DataTemplate x:Key="NewsEntry">
            <Grid Margin="0,0,0,14">
                <local:IronPlate CornerSize="22" />
                <Grid Margin="18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#FF454A54" BorderThickness="2" CornerRadius="2" MinHeight="128"
                            VerticalAlignment="Top">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,2,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tag}" Style="{StaticResource Stamp}" />
                            <TextBlock Text="{Binding DateText}" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="22"
                                   FontWeight="SemiBold" Margin="0,8,0,6" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{StaticResource Soft}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <Storyboard x:Key="PageIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True" MouseMove="OnRootMouseMove">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The forge, in depth (Backdrop.cs): the far wall, the anvil and its fire, the smoke, the foreground. Each
             has a cold painting under a hot one, cross-faded with the realm's state. Scene pixels: 1920 x 1140. -->
        <Viewbox Grid.RowSpan="2" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                 ClipToBounds="True" IsHitTestVisible="False">
            <Canvas x:Name="BackdropScene" Width="1920" Height="1140" RenderTransformOrigin="0.62,0.45">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                        <TranslateTransform />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Canvas Width="1920" Height="1140">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="BackShift" />
                    </Canvas.RenderTransform>
                    <Image Source="Assets/Forge/backWallCold.jpg" Width="1920" Height="1140" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image x:Name="WallHot" Source="Assets/Forge/backWallHot.jpg" Width="1920" Height="1140"
                           Stretch="Fill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>
                <Canvas Width="1920" Height="1140">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="MidShift" />
                    </Canvas.RenderTransform>
                    <Image Source="Assets/Forge/anvilCold.png" Canvas.Left="1204" Canvas.Top="489" Width="549"
                           Height="346" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Canvas x:Name="HotMid" Width="1920" Height="1140" Opacity="0">
                        <Image Source="Assets/Forge/anvilHot.png" Canvas.Left="1204" Canvas.Top="489" Width="549"
                               Height="346" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image x:Name="FireLight" Source="Assets/Forge/fireLight.png" Canvas.Left="941" Canvas.Top="2"
                               Width="977" Height="809" Stretch="Fill" />
                    </Canvas>
                    <Canvas x:Name="BackdropEmbers" Width="1920" Height="1140" Opacity="0" />
                </Canvas>
                <Canvas x:Name="SmokeLayer" Canvas.Top="300" Opacity="0.55">
                    <Canvas.RenderTransform>
                        <TranslateTransform />
                    </Canvas.RenderTransform>
                    <Image Source="Assets/Forge/smoke.png" Width="1920" Height="570" Stretch="Fill" />
                    <Image Source="Assets/Forge/smoke.png" Canvas.Left="1920" Width="1920" Height="570" Stretch="Fill" />
                </Canvas>
                <Canvas Width="1920" Height="1140">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="FrontShift" />
                    </Canvas.RenderTransform>
                    <Image Source="Assets/Forge/foreground.png" Width="1920" Height="1140" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>
            </Canvas>
        </Viewbox>
        <!-- Shade where the words sit: the left column and the workbench at the bottom -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#D0101113" Offset="0" />
                    <GradientStop Color="#80101113" Offset="0.38" />
                    <GradientStop Color="#00101113" Offset="0.6" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00101113" Offset="0.62" />
                    <GradientStop Color="#C0101113" Offset="0.86" />
                    <GradientStop Color="#F0101113" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Pages other than home sit on a darker veil -->
        <Rectangle x:Name="Veil" Grid.RowSpan="2" Fill="#EA101113" Opacity="0" IsHitTestVisible="False" />

        <!-- The header band: the mark, the pages, the window's buttons -->
        <Grid MouseLeftButtonDown="OnDragWindow">
            <Grid.Background>
                <ImageBrush ImageSource="Assets/Forge/headerBand.png" Stretch="Fill" />
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0,30,0" VerticalAlignment="Center">
                <Image Source="Assets/Forge/emblem.png" Width="40" Height="40" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="EVOLUTIONS" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="22"
                           VerticalAlignment="Center" Foreground="{StaticResource Text}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavTab}" IsChecked="True" Checked="OnNavigate"
                             Content="ACCUEIL" />
                <RadioButton x:Name="NavNews" Style="{StaticResource NavTab}" Checked="OnNavigate">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ANNONCES" VerticalAlignment="Center" />
                        <!-- Only while the newest article is recent -->
                        <Border x:Name="NewsBadge" CornerRadius="2" Background="#FFC84B10" Padding="5,1"
                                Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="NOUVEAU" FontSize="9" FontWeight="Bold" Foreground="#FFFFF1DF" />
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" Checked="OnNavigate"
                             Content="RÉGLAGES" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <Border x:Name="VersionPill" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Muted}" />
                </Border>
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Home -->
        <Grid x:Name="HomePage" Grid.Row="1">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>

            <!-- The left column: the featured article, then the chronicle -->
            <StackPanel Width="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="44,30,0,0">
                <!-- Rotates through the newest articles; hovering it holds the current one -->
                <Border x:Name="Featured" Background="Transparent" Cursor="Hand" MouseEnter="OnFeaturedEnter"
                        MouseLeave="OnFeaturedLeave" MouseLeftButtonUp="OnFeaturedClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="96" BorderBrush="#FF454A54" BorderThickness="2" CornerRadius="2"
                                VerticalAlignment="Top">
                            <Border.Background>
                                <ImageBrush x:Name="FeaturedImage" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="À LA UNE  ·  " Style="{StaticResource Stamp}" />
                                <TextBlock x:Name="FeaturedTagText" Style="{StaticResource Stamp}" />
                            </StackPanel>
                            <TextBlock x:Name="FeaturedTitle" FontFamily="{StaticResource Display}" FontWeight="Bold"
                                       FontSize="26" TextWrapping="Wrap" LineHeight="29" MaxHeight="58" Margin="0,6,0,0"
                                       LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis"
                                       Foreground="#FFF6F0E8">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.9" Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <!-- One pill per featured article; filled in by ShowNews -->
                                <StackPanel x:Name="FeaturedDots" Orientation="Horizontal" VerticalAlignment="Center" />
                                <TextBlock Text="Lire l'annonce →" Foreground="{StaticResource Gold}" FontSize="13"
                                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="CHRONIQUE" Style="{StaticResource Stamp}" Foreground="{StaticResource Muted}"
                           Margin="0,34,0,10" FontSize="12" />
                <ItemsControl x:Name="NewsCards" ItemTemplate="{StaticResource NewsCard}" />
            </StackPanel>

            <!-- The workbench: the ingot, what the launcher is doing, the realm -->
            <Grid VerticalAlignment="Bottom" Height="132" Margin="24,0,24,20">
                <local:IronPlate CornerSize="30" />
                <Grid Margin="26,16,26,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The ingot: cold iron, the molten one revealed over it as far as the work has gone, its
                         glow behind while it is ready. The hammer and the sparks of the strike above it. -->
                    <Grid x:Name="IngotArea" Margin="0,-6,0,-6" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PlayButton}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="1.03" Duration="0:0:0.15" />
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="1.03" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="1" Duration="0:0:0.25" />
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="1" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Image x:Name="IngotGlow" Source="Assets/Forge/ingotGlow.png" Margin="-34,-24" Opacity="0"
                               Stretch="Fill" IsHitTestVisible="False" />
                        <Image Source="Assets/Forge/ingotCold.png" Stretch="Fill" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border x:Name="IngotFill" HorizontalAlignment="Left" Width="0" ClipToBounds="True"
                                IsHitTestVisible="False">
                            <Image Source="Assets/Forge/ingotHot.png" Stretch="Fill" HorizontalAlignment="Left"
                                   Width="{Binding ActualWidth, ElementName=IngotArea}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" IsEnabled="False" Click="OnPlay"
                                Margin="30,18">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="PlayText" Text="JOUER" FontFamily="{StaticResource Display}"
                                           FontWeight="Bold" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="#FF2A140A" />
                                <TextBlock x:Name="PlaySub" FontFamily="{StaticResource Display}" FontSize="11.5"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#CC2A140A"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <!-- The strike: the hammer coming down on the ingot, sparks bursting from it -->
                        <Canvas IsHitTestVisible="False">
                            <Image x:Name="Hammer" Source="Assets/Forge/hammer.png" Width="190" Height="142"
                                   Canvas.Left="190" Canvas.Top="-118" Opacity="0" RenderTransformOrigin="0.92,0.9">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="HammerRotation" Angle="-55" />
                                </Image.RenderTransform>
                            </Image>
                            <Image x:Name="Sparks" Width="300" Height="300" Canvas.Left="10" Canvas.Top="-104"
                                   Opacity="0" />
                        </Canvas>
                    </Grid>

                    <Button x:Name="PlayMenuButton" Grid.Column="1" Style="{StaticResource PlayMenuButton}" Width="40"
                            Height="56" Margin="10,0,0,0" ToolTip="Outils du jeu" Click="OnPlayMenu">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PlayMenu" Style="{StaticResource PlayMenuStyle}" Width="236">
                                <MenuItem x:Name="PlayMenuRepair" Header="Réparer le jeu" Style="{StaticResource PlayMenuItem}"
                                          Click="OnRepair">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="PlayMenuCache" Header="Vider le cache" Style="{StaticResource PlayMenuItem}"
                                          Click="OnClearCache">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="PlayMenuFolder" Header="Ouvrir le dossier du jeu"
                                          Style="{StaticResource PlayMenuItem}" Click="OnOpenFolder">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Réglages" Style="{StaticResource PlayMenuItem}"
                                          Click="OnPlayMenuSettings">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>

                    <!-- What the launcher is doing, and the channel the metal runs in while it works -->
                    <StackPanel Grid.Column="2" Margin="26,0,22,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,1,10,0" />
                            <TextBlock x:Name="StatusText" FontFamily="{StaticResource Display}" FontSize="19"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DetailText" FontSize="13" Foreground="{StaticResource Muted}" Margin="24,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid x:Name="ProgressTrack" Height="12" Margin="0,12,0,0">
                            <Border CornerRadius="2" Background="#FF121316" BorderBrush="#FF3B3F48" BorderThickness="1" />
                            <Border x:Name="ProgressFill" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                                    Margin="1" Background="{StaticResource MoltenBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFFF8A2A" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- The realm -->
                    <Border Grid.Column="3" BorderBrush="#FF3B3F48" BorderThickness="1,0,0,0" Padding="22,0,4,0"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="ROYAUME" Style="{StaticResource Stamp}" Foreground="{StaticResource Muted}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,4,0,0">
                                    <Ellipse x:Name="RealmHalo" Fill="{StaticResource Muted}" Opacity="0.25" />
                                    <Ellipse x:Name="RealmDot" Width="9" Height="9" Fill="{StaticResource Muted}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0" MinWidth="110">
                                    <TextBlock x:Name="RealmState" Text="Vérification…" FontFamily="{StaticResource Display}"
                                               FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RealmDetail" FontSize="12" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <!-- Only while the realm is down: no need to wait for the next 30 second check -->
                                <Button x:Name="RealmRetry" Grid.Column="2" Style="{StaticResource LinkButton}"
                                        Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0"
                                        Click="OnRealmRetry" ToolTip="Vérifier maintenant">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- News -->
        <Grid x:Name="NewsPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="ANNONCES" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="30"
                       Margin="40,26,40,16" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="40,0,34,10">
                <ItemsControl x:Name="NewsList" ItemTemplate="{StaticResource NewsEntry}" />
            </ScrollViewer>
        </Grid>

        <!-- Settings -->
        <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,26,34,10">
                <StackPanel Width="780" HorizontalAlignment="Left">
                    <TextBlock Text="RÉGLAGES" FontFamily="{StaticResource Display}" FontWeight="Bold"
                               FontSize="30" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <local:IronPlate CornerSize="22" />
                        <Grid Margin="32,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DOSSIER DU JEU" Style="{StaticResource Stamp}" FontSize="14" />
                                <TextBlock x:Name="FolderText" Margin="0,6,0,0" Foreground="{StaticResource Soft}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}" Content="OUVRIR"
                                        Click="OnOpenFolder" Margin="16,0,8,0" />
                                <Button x:Name="ChangeFolderButton" Style="{StaticResource GhostButton}"
                                        Content="CHANGER" Click="OnChangeFolder" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <local:IronPlate CornerSize="22" />
                        <Grid Margin="32,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RÉPARER LE JEU" Style="{StaticResource Stamp}" FontSize="14" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Soft}" TextWrapping="Wrap"
                                           Text="Vérifie chaque fichier du patch et retélécharge ce qui manque ou a été abîmé." />
                            </StackPanel>
                            <Button x:Name="RepairButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="RÉPARER" Click="OnRepair" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <local:IronPlate CornerSize="22" />
                        <Grid Margin="32,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VIDER LE CACHE" Style="{StaticResource Stamp}" FontSize="14" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Soft}" TextWrapping="Wrap"
                                           Text="Corrige les objets, sorts ou quêtes qui s'affichent mal en jeu. Le jeu le reconstruit tout seul." />
                            </StackPanel>
                            <Button x:Name="CacheButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="VIDER" Click="OnClearCache" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="AboutText" Margin="2,10,0,0" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
