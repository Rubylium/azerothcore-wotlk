<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "La Forge" (.agents/plans/launcher-forge): dark iron and molten metal. Display text in Bahnschrift, Windows'
         own condensed industrial face (no font file to ship), the rest in Segoe UI. -->
    <FontFamily x:Key="Display">Bahnschrift</FontFamily>

    <SolidColorBrush x:Key="Base" Color="#FF131416" />
    <SolidColorBrush x:Key="Iron" Color="#FF22252B" />
    <SolidColorBrush x:Key="Plate" Color="#FF2B2E35" />
    <SolidColorBrush x:Key="Rivet" Color="#FF454A54" />
    <SolidColorBrush x:Key="Text" Color="#FFF3EDE6" />
    <SolidColorBrush x:Key="Soft" Color="#FFD4CCC2" />
    <SolidColorBrush x:Key="Muted" Color="#FF8D867E" />
    <!-- Molten: the accent; Gold kept as its name for the code that asks for it -->
    <SolidColorBrush x:Key="Gold" Color="#FFFF9A3C" />
    <SolidColorBrush x:Key="GoldLight" Color="#FFFFCF9A" />
    <SolidColorBrush x:Key="Online" Color="#FF8FD16A" />
    <SolidColorBrush x:Key="Offline" Color="#FFD26A4A" />
    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFB347" Offset="0" />
        <GradientStop Color="#FFFF7A1A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoltenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFE0A0" Offset="0" />
        <GradientStop Color="#FFFF8A2A" Offset="0.55" />
        <GradientStop Color="#FFC84B10" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="2" Background="#F71B1D22" BorderBrush="#FF454A54" BorderThickness="1"
                            Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
