[worldserver]

# Enable the permanent stat-growth system.
StatGrowth.Enabled = 1

# Automatically learn every eligible class-trainer spell for free on login and level-up.
StatGrowth.AutoLearnClassSpells = 1

# Adds persistent, class-compatible bonuses to equipment without changing its identity or quality.
PersonalLoot.Enabled = 1

# Require the PersonalLoot client addon handshake after entering the world.
PersonalLoot.RequireAddon = 1
PersonalLoot.AddonGraceSeconds = 20

# Chance for an item to receive bonuses, based on its original Blizzard quality.
GearBonus.PoorChance = 5.0
GearBonus.CommonChance = 10.0
GearBonus.UncommonChance = 25.0
GearBonus.RareChance = 45.0
GearBonus.EpicChance = 70.0
GearBonus.LegendaryChance = 100.0

# Bonus scaling per item level. PercentScale is used by XP, resource and vitality.
# Fortune uses its own budget: 1-2% per item, at most 20% from all equipped gear.
GearBonus.AttributeScale = 0.10
GearBonus.PercentScale = 0.015

# Leech heals the wearer for a percentage of the effective damage they deal. LeechScale is its value per item
# level; MaxLeech caps the total from all equipped items.
GearBonus.LeechScale = 0.005
GearBonus.MaxLeech = 10.0

# Improve equipment already selected by a creature's normal loot table. This does not add another drop roll.
# Uncommon or better equipment that is unusable or obsolete is replaced with class-appropriate gear of the same
# quality for a missing or weak slot. Poor and common equipment is left as dropped. A replacement is never an item
# the player already owns or one already on the same corpse.
SmartLoot.Enabled = 1

# Replacement items must require no less than this many levels below the progression level.
SmartLoot.LevelWindow = 5

# A creature may provide equipment up to this many levels above its own level, capped at the player's level.
# This prevents farming trivial creatures for current-level gear.
SmartLoot.CreatureLevelTolerance = 3

# Chance for an eligible creature corpse to contain an Essence of Growth.
StatGrowth.DropChance = 10.0

# Permanent points granted whenever one essence is consumed.
StatGrowth.BonusPerUse = 1

# Uses a native client Item.dbc entry so the inventory icon works without a client patch.
StatGrowth.ItemEntry = 42590

# Independent chance for an eligible corpse to contain an Essence of Experience.
StatGrowth.ExperienceDropChance = 10.0

# Permanent, stacking experience-gain percentage granted per essence.
StatGrowth.ExperienceBonusPerUse = 10

# Uses a native client Item.dbc entry so the inventory icon works without a client patch.
StatGrowth.ExperienceItemEntry = 39163

# Independent chance for an eligible corpse to contain an Essence of Resource.
StatGrowth.ResourceDropChance = 10.0

# Permanent primary-resource regeneration percentage per essence. Effective bonus (essences, gear, bots) caps at 500%.
# Capped Resource essences grant another uncapped essence family of the same tier when consumed.
StatGrowth.ResourceBonusPerUse = 1

# Uses a native client Item.dbc entry so the inventory icon works without a client patch.
StatGrowth.ResourceItemEntry = 21238

# Independent chance for an eligible corpse to contain an Essence of Vitality.
StatGrowth.VitalityDropChance = 10.0

# Permanent, stacking Vitality points granted per essence.
StatGrowth.VitalityBonusPerUse = 1

# Maximum health each Vitality point gives, per character level: a flat amount added to health that keeps its
# worth while levelling (0.5: +10 health per point at level 20, +40 at level 80).
StatGrowth.VitalityHealthPerLevel = 0.5

# Uses a native client Item.dbc entry so the inventory icon works without a client patch.
StatGrowth.VitalityItemEntry = 41606

# Independent chance for an eligible corpse to contain an Essence of Fortune.
StatGrowth.FortuneDropChance = 10.0

# Permanent Fortune percentage granted per essence. Fortune increases gold gains and the chance and strength of
# gear bonuses; it never changes which item drops, its item level or item counts.
StatGrowth.FortuneBonusPerUse = 1

# Uses a native client Item.dbc entry so the inventory icon works without a client patch.
StatGrowth.FortuneItemEntry = 23656

# Tier distribution within an already-successful essence drop.
# Faint receives the remaining chance (80% with these defaults).
StatGrowth.GreaterTierChance = 18.0
StatGrowth.AscendantTierChance = 2.0

# Permanent bonus multipliers for higher tiers. Faint always uses 1x.
StatGrowth.GreaterTierMultiplier = 3
StatGrowth.AscendantTierMultiplier = 10

# What a Mythic+ clear pays in essences. Nothing drops during a key -- every creature in one is stripped of its
# loot -- so the end of the run pays for the whole dungeon at once.
#
# The baseline is a number of kills. It is multiplied by the drop chances above, so a clear pays what the same
# dungeon would have dropped on heroic (60 kills x 50% = 30 essences with the defaults) and the chances stay the
# single place the rate is set. It is a fixed count rather than the run's real one on purpose: a key is routed
# around the packs it can skip, and paying per kill would push groups into fighting the timer for essences.
StatGrowth.MythicEssenceBaseline = 60

# Added to that per key level, in percent: +2 pays 1.2x the baseline, +10 pays 2x. Key level also keeps rolling
# the essence tier more times, so higher keys pay better twice over.
StatGrowth.MythicEssenceBonusPerKeyLevel = 10.0

# Essences are consumed automatically when looted and never take bag space. Essences obtained another way
# (trade, mail, older stacks) are still used by right-clicking them.

# Extra gear bonus roll chance, per Fortune percent, added to the GearBonus quality chance.
Fortune.GearBonusChancePerPoint = 0.1

# Extra gear bonus value percent per Fortune percent, capped by MaxGearBonusValueIncrease.
Fortune.GearBonusValuePerPoint = 0.1
Fortune.MaxGearBonusValueIncrease = 10.0

# Hard economy limits apply even with larger configuration values:
# Fortune from essences and equipment caps at 100% (earned gold at most x2).
# Fortune adds at most 10 percentage points of affix chance and 10% affix strength; it cannot boost its own rolls.
# Trades, mail, auctions, vendor sales and refunds receive no Fortune multiplier.
# Capped Fortune essences become an uncapped essence family of the same tier; stored points/items are not migrated.

###############################################################################
# PARAGON BOARD
#
# A second layer of permanent power on top of the essences, spent on a tree
# rather than granted flat. A node is worth several essences at least, so every
# point is an event rather than a trickle.
#
# The board itself is data (paragon_node / paragon_node_link), generated by
# localTools/paragon/buildParagonTree.py. Reshaping the tree is a rerun of that
# script, not a rebuild.

Paragon.Enabled = 1

# Points a character may have spent at once. Points keep coming past this (bosses, keys and
# paragon levels from experience at the level cap) and
# are banked, appearing the moment the cap is raised, so a drop at cap is never
# wasted.
Paragon.PointCap = 10

# Added to Paragon.PointCap for each prestige. Points already earned past the old cap become
# spendable as soon as the cap moves.
Paragon.PointsPerPrestige = 20

# Chance, in percent, that a boss kill awards a point. Rolled per player, so
# nobody competes with their own group for it. Trash never awards one: a long
# dungeon should not out-farm a hard one.
Paragon.NormalBossChance = 3.0
Paragon.HeroicBossChance = 8.0
Paragon.MythicZeroBossChance = 15.0
Paragon.RaidBossChance = 25.0
Paragon.RaidHeroicBossChance = 40.0

# A key adds its level on top of the base, so +10 is 15 + 30 = 45%.
Paragon.MythicBossChance = 15.0
Paragon.MythicBossChancePerKeyLevel = 3.0

###############################################################################
# BOTS IN GROUPS WITH REAL PLAYERS
#
# A bot in a group with real players carries the average essences of the group's
# real players on its map (Growth spread over its class's stats the way a player
# of that class receives them, Vitality, Resource), applied out of combat and
# never saved. Experience and Fortune are left out.
BotEssences.Enabled = 1

# Temporary catch-up until every class's bot has a proper rotation: in dungeons
# and raids, a damage-dealing bot moves its damage multiplier towards TargetShare
# of the real damage dealers' average DPS (smoothed over about 30 s of combat),
# up to 25% every 2 s and down 10% every 5 s at most, from 1 up to
# MaxMultiplier (0: no limit). Shown on
# the bot as stacks of Chaotic Charge, one per percent up to 200 (the bonus goes
# on past it); .botcatchup lists it.
BotCatchUp.Enabled = 1
BotCatchUp.TargetShare = 0.75
BotCatchUp.MaxMultiplier = 0

# Class ids, comma separated, whose bots never get it: their AI was reworked
# (1 Warrior, 2 Paladin, 3 Hunter, 4 rogue, 5 Priest, 6 Death Knight, 8 mage, 10 Oathblade).
BotCatchUp.ExcludedClasses = "1,2,3,4,5,6,8,10"

###############################################################################
# MYTHIC+ GEAR LOOKS
#
# Generated Mythic+ items (item level 285 and up) look like their base item.
# With this on, other players, the character's own model and the character
# list see a real item of the same slot and armour or weapon type instead,
# picked by item level (a tier set, then a famous weapon, the legendaries on
# top), and generated weapons glow by tier. Only the visible look changes: the
# item, its tooltip, inspection and its real enchantment stay. A player turns it
# off for their character with .appearance off.
#
# The tiers are data (mythic_appearance_tier / mythic_appearance_glow),
# generated by localTools/mythicAppearance/buildMythicAppearance.py.
MythicAppearance.Enabled = 1
